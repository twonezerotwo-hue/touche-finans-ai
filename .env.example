# Touche Finans AI - ornek ortam degiskenleri
# Gercek secret EKLEMEYIN. Bu dosyayi .env olarak kopyalayip doldurun.

# --- Yerel sunucu ---
FINANS_UI_PORT=8765

# --- Smart Excel: tek ANA + tek YEDEK (bos birakirsaniz varsayilanlar kullanilir; bkz. README) ---
# (TOUCHE_BASE_DIR yalniz gercek ortam degiskeni olarak calisir; .env dosyasi onun icinden okundugu icin burada etkisizdir)
# TOUCHE_MAIN_WORKBOOK=C:\Users\<kullanici>\...\Touche Holding - AI Ready Finans Yönetim Sistemi.xlsx
# TOUCHE_BACKUP_WORKBOOK=C:\Users\<kullanici>\...\Touche Holding - AI Ready Finans Yönetim Sistemi_backup.xlsx   (varsayilan: ANA ile ayni klasorde _backup)
# TOUCHE_LEDGER_SON_SATIR=300

# --- LLM / Ollama ---
OLLAMA_TEXT_MODEL=qwen3:8b
TEXT_LLM_PROVIDER=ollama

# --- Evren (uzak LLM) - opsiyonel; bos ise kullanilmaz ---
EVREN_API_KEY=
EVREN_API_BASE=https://evren-llmapi.ssyz.org.tr/v1
EVREN_MODEL=auto

# --- Witan (uzak Excel orkestrasyon) - opsiyonel ---
WITAN_REMOTE_ENABLED=false

# --- Telegram - opsiyonel ---
TELEGRAM_BOT_TOKEN=
